NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=scoutapotres
MEDIA_DIRECTORY=.data/media
TRUST_PROXY_HOPS=0
# Comma-separated browser origins. Native React Native requests do not need CORS.
CORS_ORIGINS=http://localhost:8081
# Set all three to enable password recovery. No reset tokens are returned or logged.
# SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_FROM=admin@example.com
# PASSWORD_RESET_URL=https://your-domain.example/reset-password
# SMTP_USER=
# SMTP_PASSWORD=
# CONTACT_EMAIL=
# PRIVACY_POLICY_URL=
ABOUT_TEXT=Groupe Scout des Apôtres
# Comma-separated language codes; left undecided until selected.
SUPPORTED_LANGUAGES=
